{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Copy to an ignored wrangler.us.local.jsonc and use the EXISTING Worker name.
  "name": "REPLACE_WITH_EXISTING_WORKER_NAME",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Always run authentication before serving /us or any of its files.
    "run_worker_first": ["/us", "/us/*"]
  },
  "d1_databases": [{ "binding": "US_DB", "database_name": "just-us", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }]
  // Configure ACCESS_ISSUER, ACCESS_AUD and ACCESS_ALLOWED_EMAILS as Worker secrets.
  // Retain the existing Worker's domains, routes and other bindings when integrating.
}
